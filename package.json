{
  "name": "valenced-elevenlabs-transcription",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {"node": ">=22.18"},
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test build/tests/tests/*.test.js",
    "build:cli": "tsc -p vendor/cli/tsconfig.json",
    "bundle": "node vendor/cli/dist/main.js build elevenlabs-transcription",
    "test:lifecycle": "node --test tests/lifecycle.test.mjs",
    "package": "node scripts/package.mjs",
    "verify": "npm run typecheck && npm test && npm run build:cli && npm run bundle && npm run test:lifecycle && npm run package"
  },
  "dependencies": {
    "@valenced/types": "file:vendor/types",
    "@swc/core": "1.16.2",
    "fflate": "0.8.3",
    "rolldown": "1.2.7",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "react-native": "0.81.6"
  }
}
